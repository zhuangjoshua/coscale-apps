# --- Auth (Google is the only login method) ---------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# → APIs & Services → Credentials. Authorized redirect URI must be exactly:
#   ${APP_URL}/api/auth/google/callback   e.g. http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of this app (used to build the Google redirect URI and login links)
APP_URL=http://localhost:3000

# Signs session cookies. Required in production: openssl rand -base64 32
SESSION_SECRET=

# --- AI ---------------------------------------------------------------------
# Preferred: Claude (schema-enforced output + live web research)
ANTHROPIC_API_KEY=
# Fallback: DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=

# --- Email (only used by the local-dev login fallback; unused once Google is set)
RESEND_API_KEY=
EMAIL_FROM=
