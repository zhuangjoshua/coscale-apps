# Google sign-in (required in production)
#   Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
#   and add this exact authorised redirect URI:
#     https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Any long random string; rotating it signs everyone out.
#   openssl rand -base64 48
PAGEWRIGHT_SESSION_SECRET=

# Public origin — baked into canonical / og:url / sitemap at SITE BUILD time,
# so pass it when building (docker build --build-arg SITE_URL=…), not just at run.
VITE_SITE_URL=https://yourdomain.com

# Optional
PORT=4310
PAGEWRIGHT_SESSION_TTL=604800
# Only needed if the site is hosted on a different origin than the API.
PAGEWRIGHT_ALLOWED_ORIGINS=
